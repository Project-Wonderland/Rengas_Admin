{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "Rengas-Admin": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/Rengas-Admin",
            "baseHref": "/Rengas_Admin/",  
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob":"**/*","input":"src/assets","output":"assets"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {"production": {"optimization": true,"outputHashing": "all"}}
        },
        "serve": {"builder": "@angular-devkit/build-angular:dev-server","options": {"buildTarget": "Rengas-Admin:build"}}
      }
    }
  }
}
